# 复制为同目录的 .env，并填写密钥。
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# 默认直连官方服务；只需填写所用服务的密钥。
GEMINI_API_KEY=
# 可选：使用网关时填写从当前运行环境可访问的服务地址。
# GEMINI_BASE_URL=https://your-gateway.example
# 文本和生图均使用 Google 官方 SDK；地址不包含 /v1 或 /v1beta。
# 生图默认复用 GEMINI_BASE_URL；仅需独立地址时填写此项。
# GEMINI_IMAGE_BASE_URL=https://your-image-gateway.example
GEMINI_PROTOCOL=gemini
# 可选：仅需要代理的 Provider 填写对应的代理地址；未配置则直连。
# GEMINI_PROXY_URL=http://your-proxy.example:8080
# 仅在 search.api_key_env 指向此变量时使用；留空不会影响原生搜索。
DEEPSEEK_SEARCH_API_KEY=
