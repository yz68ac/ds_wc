# 复制为同目录的 .env，并填写密钥。
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Gemini 独立连接；经 CPA 时填 CPA client key，8317 由本机服务或 SSH 转发提供。
GEMINI_API_KEY=
GEMINI_BASE_URL=http://127.0.0.1:8317/v1
# 原生生图地址，不包含 /v1 或 /v1beta；复用 GEMINI_API_KEY。
GEMINI_IMAGE_BASE_URL=http://127.0.0.1:8317
GEMINI_PROTOCOL=openai_compatible
# 到本机 CPA 直连，CPA 负责上游代理。
GEMINI_PROXY_URL=
# 仅在 search.api_key_env 指向此变量时使用；留空不会影响原生搜索。
DEEPSEEK_SEARCH_API_KEY=
