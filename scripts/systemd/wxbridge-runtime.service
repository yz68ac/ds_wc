[Unit]
Description=Prepare private WeChat bridge runtime
Requires=run-wxbridge\x2dtrial.mount
After=run-wxbridge\x2dtrial.mount
Before=wxbridge-session.service wxbridge-recover.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 /usr/local/libexec/wxbridge-boot.py runtime
UMask=0077
LimitCORE=0
