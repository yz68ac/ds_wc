[Unit]
Description=Verify WeChat login, prepare keys and resume listener
Requires=wxbridge-runtime.service
Wants=wxbridge-session.service
After=wxbridge-runtime.service wxbridge-session.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/libexec/wxbridge-boot.py recover
TimeoutStartSec=240
UMask=0077
LimitCORE=0
