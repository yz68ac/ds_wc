[Unit]
Description=WeChat headless session
Requires=wxbridge-runtime.service
After=wxbridge-runtime.service network-online.target
Wants=network-online.target
Before=wxbridge-recover.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=wxbridge
Group=wxbridge
WorkingDirectory=/opt/wxbridge
Environment=HOME=/var/lib/wxbridge
Environment=WX_RUNTIME_DIR=/run/wxbridge-trial
ExecStart=/usr/bin/python3 /opt/wxbridge/scripts/boot-session.py
Restart=on-failure
RestartSec=15
KillMode=control-group
TimeoutStopSec=45
UMask=0077
LimitCORE=0
StandardOutput=append:/run/wxbridge-trial/session-supervisor.log
StandardError=append:/run/wxbridge-trial/session-supervisor.log

[Install]
WantedBy=multi-user.target
