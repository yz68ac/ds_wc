{
  "db_dir": "",
  "keys_file": "/run/wxbridge-trial/keys.json",
  "decrypted_dir": "/run/wxbridge-trial/decrypted",
  "state_file": "/run/wxbridge-trial/state.json",
  "log_file": "/run/wxbridge-trial/bot.log",
  "wechat_process": "wechat",
  "source": "db",
  "poll_interval_seconds": 2,
  "reply_to_backlog": false,
  "reply_style": {
    "wechat_emoticons_enabled": false,
    "omit_trailing_period": true
  },
  "queue": {
    "debounce_seconds": 0,
    "generation_concurrency": 2,
    "generation_retries": 2,
    "generation_retry_delay_seconds": 3,
    "completed_retention": 200,
    "file": "/run/wxbridge-trial/queue.sqlite3"
  },
  "proactive": {
    "enabled": false,
    "window_seconds": 300,
    "min_messages": 10,
    "check_interval_seconds": 10,
    "evaluation_interval_seconds": 60,
    "min_new_messages": 3,
    "reply_ttl_seconds": 60,
    "timeout_seconds": 30,
    "max_reply_chars": 30,
    "entry_cooldown_seconds": 300,
    "max_entries_per_hour": 0,
    "opportunities": {
      "enabled": true,
      "min_messages": 3,
      "min_senders": 2,
      "address_names": ["ds"]
    },
    "conversation": {
      "enabled": true,
      "window_seconds": 120,
      "max_followups": 0
    }
  },
  "target": {
    "chat": "",
    "bot_name": "DeepSeek",
    "trigger": {
      "mentions": [
        "@DeepSeek",
        "@deepseek"
      ],
      "prefixes": [],
      "reply_all": false,
      "require_mention_metadata": true,
      "pat_enabled": true
    },
    "cooldown_seconds": 8,
    "max_message_age_seconds": 90,
    "context_window_seconds": 300,
    "context_max_chars": 24000,
    "max_reply_chars": 1800
  },
  "deepseek": {
    "api_key_env": "DEEPSEEK_API_KEY",
    "base_url": "https://api.deepseek.com",
    "model": "deepseek-flash",
    "thinking": "enabled",
    "reasoning_effort": "max",
    "temperature": 1,
    "timeout_seconds": 60,
    "max_tokens": 1200,
    "system_prompt_file": "prompts/system.md"
  },
  "models": {
    "reply": {},
    "participation": {
      "thinking": "disabled",
      "reasoning_effort": "high",
      "max_tokens": 256
    },
    "memory": {},
    "avatar": {
      "thinking": "enabled",
      "reasoning_effort": "max",
      "max_tokens": 1200
    }
  },
  "search": {
    "enabled": true,
    "base_url": "https://api.deepseek.com",
    "timeout_seconds": 15,
    "total_timeout_seconds": 120,
    "max_tool_rounds": 2,
    "max_requests": 3,
    "max_results": 5,
    "feedback_enabled": false,
    "feedback_phrases": [
      "我去查查，等我一下。",
      "我上网搜搜，核实一下。",
      "这事我去看看。"
    ]
  },
  "vision": {
    "enabled": true,
    "detail": "original",
    "max_images": 4,
    "max_image_bytes": 8388608,
    "cache_wait_seconds": 3
  },
  "memory": {
    "enabled": true,
    "directory": "memory",
    "model": "deepseek-flash",
    "thinking": "enabled",
    "reasoning_effort": "max",
    "system_prompt_file": "prompts/memory.md",
    "learning": {
      "enabled": true,
      "passive_enabled": true,
      "window_seconds": 300,
      "min_new_messages": 10,
      "min_senders": 2,
      "min_interval_seconds": 300
    },
    "min_interval_seconds": 60,
    "prompt_max_chars": 1200,
    "max_tokens": 8192,
    "timeout_seconds": 90,
    "avatar": {
      "enabled": true,
      "max_per_batch": 2,
      "max_bytes": 524288,
      "retry_interval_seconds": 3600
    }
  },
  "ui": {
    "backend": "auto",
    "app_names": [
      "wechat",
      "WeChat",
      "微信"
    ],
    "chat_list_names": [
      "Chats",
      "聊天",
      "会话"
    ],
    "messages_list_names": [
      "Messages",
      "消息"
    ],
    "window_class": "wechat",
    "native_executable": "/opt/wechat/wechat",
    "window_names": [
      "微信",
      "WeChat"
    ],
    "search_shortcut": "ctrl+f",
    "paste_shortcut": "ctrl+v",
    "select_all_shortcut": "ctrl+a",
    "send_key": "Return",
    "input_method": "auto",
    "verify_chat_selected": true,
    "post_send_wait": 0.8,
    "send_confirm_timeout_seconds": 10,
    "chat_open_wait": 1,
    "dry_run": true
  }
}
