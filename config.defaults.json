    "min_new_messages": 3,
    "reply_ttl_seconds": 60,
    "timeout_seconds": 30,
    "max_reply_chars": 30,
    "entry_cooldown_seconds": 300,
    "max_entries_per_hour": 0,
    "opportunities": {
      "enabled": true,
      "min_messages": 3,
      "min_senders": 2,
      "address_names": ["ds"]
    },
    "conversation": {
      "enabled": true,
      "window_seconds": 120,
      "max_followups": 0
    }
  },
  "target": {
    "chat": "",
    "bot_name": "DeepSeek",
    "trigger": {
      "mentions": [
        "@DeepSeek",
        "@deepseek"
      ],
      "prefixes": [],
      "reply_all": false,
      "require_mention_metadata": true,
      "pat_enabled": true
