{
  "native_api": {
    "enabled": false,
    "socket": "/run/wxbridge-trial/native-api.sock",
    "helper_socket": "/run/wxbridge-trial/native-helper.sock",
    "allowed_chat_ids": [
      "filehelper"
    ],
    "max_text_bytes": 4096,
    "max_pending": 16,
    "max_requests": 1024
  },
  "db_dir": "",
  "keys_file": "/run/wxbridge-trial/keys.json",
  "decrypted_dir": "/run/wxbridge-trial/decrypted",
  "state_file": "/run/wxbridge-trial/state.json",
  "log_file": "/run/wxbridge-trial/bot.log",
  "wechat_process": "wechat",
  "source": "db",
  "account": {
    "send_interval_seconds": 1
  },
  "poll_interval_seconds": 2,
  "reply_to_backlog": false,
  "reply_style": {
    "wechat_emoticons_enabled": false,
    "omit_trailing_period": false
  },
  "queue": {
    "max_pending": 32,
    "max_pending_per_sender": 8,
    "generation_lookahead": 4,
    "intake_max_pages": 4,
    "generation_retries": 2,
    "generation_retry_delay_seconds": 3,
    "completed_retention": 200,
    "file": "/run/wxbridge-trial/queue.sqlite3"
  },
  "participation": {
    "enabled": false,
    "debounce_seconds": 2,
    "max_wait_seconds": 5,
    "max_batch_messages": 8,
    "address_names": [],
    "pat_enabled": true
  },
  "target": {
    "chat": "",
    "bot_name": "小c",
    "cooldown_seconds": 8,
    "max_message_age_seconds": 90,
    "context_window_seconds": 300,
    "context_max_chars": 24000,
    "context_budget_strategy": "strict",
    "max_reply_chars": 1800
  },
  "models": {
    "reply": {
      "model": "",
      "options": {
        "max_tokens": 1200,
        "timeout_seconds": 60,
        "thinking": "disabled"
      }
    },
    "participation": {
      "model": "",
      "options": {
        "max_tokens": 256,
        "timeout_seconds": 20,
        "thinking": "disabled"
      }
    },
    "memory": {
      "model": "",
      "options": {
        "max_tokens": 1200,
        "timeout_seconds": 60,
        "thinking": "disabled"
      }
    },
    "avatar": {
      "model": "",
      "options": {
        "max_tokens": 1200,
        "timeout_seconds": 60,
        "thinking": "disabled"
      }
    },
    "group_profile": {
      "model": "",
      "options": {
        "max_tokens": 1800,
        "timeout_seconds": 45,
        "thinking": "disabled"
      }
    }
  },
  "search": {
    "enabled": true,
    "backend": "external",
    "timeout_seconds": 15,
    "total_timeout_seconds": 120,
    "max_tool_rounds": 2,
    "max_requests": 3,
    "max_results": 5,
    "feedback_enabled": false,
    "feedback_phrases": [
      "我上网搜搜，核实一下。",
      "我去看看。"
    ],
    "connection": "deepseek"
  },
  "vision": {
    "enabled": true,
    "detail": "original",
    "max_images": 4,
    "max_image_bytes": 8388608,
    "cache_wait_seconds": 3,
    "download_enabled": false,
    "download_backend": "desktop",
    "download_timeout_seconds": 20
  },
  "memory": {
    "enabled": true,
    "directory": "memory",
    "system_prompt_file": "prompts/memory.md",
    "learning": {
      "enabled": true,
      "passive_enabled": true,
      "window_seconds": 300,
      "min_new_messages": 10,
      "min_senders": 2,
      "min_interval_seconds": 300
    },
    "min_interval_seconds": 60,
    "prompt_max_chars": 1200,
    "avatar": {
      "enabled": true,
      "max_per_batch": 2,
      "max_bytes": 524288,
      "retry_interval_seconds": 3600
    }
  },
  "ui": {
    "backend": "auto",
    "app_names": [
      "wechat",
      "WeChat",
      "微信"
    ],
    "chat_list_names": [
      "Chats",
      "聊天",
      "会话"
    ],
    "messages_list_names": [
      "Messages",
      "消息"
    ],
    "window_class": "wechat",
    "native_executable": "/opt/wechat/wechat",
    "window_names": [
      "微信",
      "WeChat"
    ],
    "search_shortcut": "ctrl+f",
    "paste_shortcut": "ctrl+v",
    "select_all_shortcut": "ctrl+a",
    "send_key": "Return",
    "input_method": "auto",
    "verify_chat_selected": true,
    "post_send_wait": 0.8,
    "send_confirm_timeout_seconds": 10,
    "chat_open_wait": 1,
    "dry_run": true
  },
  "model_clients": {
    "reply": "deepseek",
    "image": "openai",
    "background": "deepseek"
  },
  "system_prompt_file": "prompts/system.md",
  "provider_env": null,
  "profile": {
    "enabled": false,
    "initial_history_days": 7,
    "initial_max_messages": 300,
    "batch_size": 60,
    "min_new_messages": 50,
    "min_interval_seconds": 1800,
    "summary_max_chars": 1200,
    "analysis_max_chars": 24000
  }
}
